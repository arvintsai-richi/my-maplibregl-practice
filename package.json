{
  "name": "dotnet-template",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "description": "部門共用.NET模版",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode %npm_config_mode%",
    "prebuild": "npm i",
    "preview": "vite preview",
    "test": "vitest",
    "postinstall": "simple-git-hooks",
    "format": "npx prettier . --write",
    "check": "npx npm-check-updates"
  },
  "simple-git-hooks": {
    "pre-commit": "cd MapLibreGLPractice.Client && npx.cmd lint-staged"
  },
  "lint-staged": {
    "*.{js,vue,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "axios": "^1.12.2",
    "dayjs": "^1.11.23",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "lint-staged": "^15.4.3",
    "prettier": "3.4.2",
    "sass": "^1.84.0",
    "simple-git-hooks": "2.11.1",
    "typescript": "^5.7.3",
    "vite": "^6.3.6",
    "vitest": "^3.0.5"
  }
}
